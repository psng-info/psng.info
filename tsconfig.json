{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "src", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strictNullChecks": false,
    "noImplicitAny": false,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
