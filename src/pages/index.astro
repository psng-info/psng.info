---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Platzhalter für den Spike – die eigentliche Startseite kommt in Phase 5.
const events = await getCollection("events");
---

<BaseLayout title="PSNG – Astro-Spike" description="Astro-Spike">
  <main class="container mx-auto max-w-3xl px-4 py-24">
    <h1 class="font-heading text-4xl font-bold">PSNG – Astro-Spike</h1>
    <ul class="mt-6 list-disc pl-6">
      {events.map((e) => <li><a class="text-primary underline" href={`/events/${e.id}`}>{e.id}</a></li>)}
    </ul>
  </main>
</BaseLayout>
