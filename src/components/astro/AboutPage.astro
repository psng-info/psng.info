---
import { Image } from "astro:assets";
import { ExternalLink } from "lucide-react";
import teamPhoto from "@/assets/Team-2026-08.webp";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { pathFor } from "@/i18n/routes";
import { HOME_ANCHORS } from "@/lib/anchors";
import { loadPartnerList, loadTeam } from "@/lib/content";
import { alternatesOf } from "@/lib/seo/alternates";

/*
 * /ueber-uns und /en/about: wofür das PSNG steht, wer es macht, mit wem es
 * zusammenarbeitet. Alles statisch – nichts hier braucht JavaScript.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const [team, partnerList] = await Promise.all([loadTeam(), loadPartnerList()]);
// Hier alphabetisch, damit keine Reihenfolge eine Rangfolge behauptet; `order`
// gilt weiter für die Logoleiste der Startseite.
const partners = partnerList.toSorted((a, b) =>
  (a.displayName ?? a.name).localeCompare(b.displayName ?? b.name, locale),
);
const contact = (subject: string) => `${pathFor("home", locale)}?subject=${subject}#${HOME_ANCHORS.contact}`;

const h2 = "mb-4 font-heading text-3xl font-bold text-foreground md:text-4xl";
const card = "flex flex-col rounded-2xl border border-border bg-card p-6 transition-shadow hover:shadow-lg";
const external = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  locale={locale}
  title={c.meta.about.title}
  description={c.meta.about.description}
  alternates={alternatesOf("about")}
  current="about"
>
  <section class="pb-16 pt-32 md:pb-24 md:pt-40">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-16" data-reveal>
        <div>
          <h1 class="font-heading text-4xl font-bold leading-[1.1] text-foreground md:text-5xl">{c.about.title}</h1>
          <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-foreground/75">{c.about.intro}</p>
        </div>
        <div class="rounded-2xl bg-primary/5 p-8">
          <h2 class="font-heading text-sm font-semibold text-primary">{c.about.visionTitle}</h2>
          <p class="mt-3 font-heading text-xl font-medium leading-snug text-foreground md:text-2xl">{c.about.visionText}</p>
        </div>
      </div>

      <ul class="mt-16 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          c.about.pillars.map((pillar) => (
            <li class="border-t-2 border-primary/40 pt-4">
              <h3 class="font-heading text-lg font-semibold text-foreground">{pillar.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{pillar.description}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-16" data-reveal>
        <div>
          <h2 class="font-heading text-xl font-semibold text-foreground">{c.about.statusTitle}</h2>
          <p class="mt-3 max-w-[65ch] leading-relaxed text-muted-foreground">{c.about.statusText}</p>
        </div>
        <div>
          <h2 class="font-heading text-xl font-semibold text-foreground">{c.about.modelsTitle}</h2>
          <p class="mt-3 max-w-[65ch] leading-relaxed text-muted-foreground">{c.about.modelsText}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="team" class="bg-primary/5 py-16 md:py-24">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-16 grid items-center gap-10 lg:grid-cols-[1fr_minmax(0,30rem)] lg:gap-16" data-reveal>
        <div>
          <h2 class={h2}>{c.team.title}</h2>
          <p class="max-w-[65ch] text-lg leading-relaxed text-muted-foreground">{c.team.intro}</p>
        </div>
        <figure>
          <Image
            src={teamPhoto}
            alt={c.team.photoCaption}
            widths={[480, 960]}
            sizes="(min-width: 1024px) 480px, 100vw"
            class="h-auto w-full rounded-2xl border border-border shadow-sm"
          />
          <figcaption class="mt-3 text-sm text-muted-foreground">{c.team.photoCaption}</figcaption>
        </figure>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          team.map((member, i) => (
            <div class={card} data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
              <Image
                src={member.photo}
                alt={member.name}
                width={160}
                height={160}
                densities={[1, 2]}
                class="mx-auto mb-4 h-40 w-40 rounded-full border-2 border-primary/20 object-cover"
              />
              <div class="flex flex-1 flex-col text-center">
                <h3 class="font-heading text-base font-semibold text-foreground">{member.name}</h3>
                <ul class="mt-2 flex flex-wrap justify-center gap-1.5">
                  {member.roles.map((r) => (
                    <li class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">{pick(r, locale)}</li>
                  ))}
                </ul>
                {(member.study || member.place) && (
                  <p class="mt-2 text-xs text-muted-foreground">
                    {[member.study, member.place].filter((x) => x).map((x) => pick(x!, locale)).join(" · ")}
                  </p>
                )}
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{pick(member.bio, locale)}</p>
                {member.linkedinUrl && (
                  <div class="mt-auto border-t border-border/50 pt-3">
                    <a href={member.linkedinUrl} {...external} class="inline-block text-xs font-medium text-primary hover:underline">
                      {c.team.linkedin}
                    </a>
                  </div>
                )}
              </div>
            </div>
          ))
        }
        <div class={card} data-reveal>
          <div class="mx-auto mb-4 flex h-40 w-40 items-center justify-center rounded-full border-2 border-primary/20 bg-muted">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="h-20 w-20 text-muted-foreground/30"
            >
              <path
                fill-rule="evenodd"
                d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="flex flex-1 flex-col text-center">
            <h3 class="font-heading text-base font-semibold text-foreground">{c.team.recruiting.name}</h3>
            <ul class="mt-2 flex flex-wrap justify-center gap-1.5">
              <li class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">{c.team.recruiting.tag}</li>
            </ul>
            <p class="mt-2 text-xs text-muted-foreground">{c.team.recruiting.place}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{c.team.recruiting.text}</p>
            <div class="mt-auto border-t border-border/50 pt-3">
              <a
                href={contact("team")}
                class="inline-flex items-center justify-center rounded-lg border border-primary/30 px-5 py-2 font-heading text-xs font-medium text-primary transition-colors hover:bg-primary/5"
              >
                {c.team.contactCta}
              </a>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-12 text-sm text-muted-foreground">
        {c.team.founderNotePrefix}Cameron Hornung{c.team.founderNoteSuffix}
      </p>
    </div>
  </section>

  <section id="kooperation" class="py-16 md:py-24">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-12" data-reveal>
        <h2 class={h2}>{c.partners.title}</h2>
        <p class="max-w-[65ch] text-lg leading-relaxed text-muted-foreground">{c.partners.intro}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          partners.map((partner, i) => {
            const name = partner.displayName ?? partner.name;
            const links: { href: string; label: string; icon?: boolean; strong?: boolean }[] = [
              { href: partner.url, label: c.partners.website, icon: true },
            ];
            if (partner.instagramUrl) links.push({ href: partner.instagramUrl, label: c.partners.instagram });
            if (partner.telegramUrl) links.push({ href: partner.telegramUrl, label: c.partners.telegram });
            if (partner.opportunity) {
              const label = partner.opportunity.label;
              links.push({ href: partner.opportunity.url, label: label ? pick(label, locale) : c.partners.opportunity, strong: true });
            }
            return (
              <div class={card} data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
                <div class="mb-4 flex justify-center">
                  <Image
                    src={partner.logo}
                    alt={`${name} Logo`}
                    height={112}
                    densities={[1, 2]}
                    class="h-28 w-auto max-w-full object-contain"
                  />
                </div>
                <div class="flex-grow">
                  <h3 class="mb-2 font-heading text-base font-semibold text-foreground">{name}</h3>
                  <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{pick(partner.description, locale)}</p>
                </div>
                <div class="mt-auto flex flex-wrap justify-center gap-3 border-t border-border/50 pt-4">
                  {links.map((l) => (
                    <a
                      href={l.href}
                      {...external}
                      class={`inline-flex items-center gap-1 text-xs text-primary hover:underline ${l.strong ? "font-medium" : ""}`}
                    >
                      {l.icon && <ExternalLink size={12} aria-hidden="true" />}
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="mt-12 rounded-2xl border border-border bg-card p-6" data-reveal>
        <p class="text-sm text-muted-foreground">
          {c.partners.ctaBefore}<a href={contact("kooperation")} class="font-medium text-primary hover:underline"
            >{c.partners.ctaLink}</a
          >{c.partners.ctaAfter}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
