---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowRight, ExternalLink, Image as ImageIcon, PlayCircle } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { seriesCalendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDate, formatEventDateShort, formatEventTime, formatRelativeToToday } from "@/lib/events/format";
import type { TimelineEntry } from "@/lib/events/schedule";
import { cardAction, cardImage, columnLabel } from "@/lib/events/view";
import PartnerChip from "./PartnerChip.astro";

/*
 * Eine Zeile im Zeitstrahl: Datum, Punkt auf der Schiene, schlanke Karte.
 * Jede Karte hat genau eine Handlung – der ganze Rest steht auf der
 * Detailseite. `data-date` und `data-end` braucht scripts/timeline.ts, um
 * Heute-Marker und Abstände nach dem Build-Tag nachzuführen.
 */
interface Props {
  entry: TimelineEntry;
  locale: Locale;
  upcoming: boolean;
  /** Der nächste anstehende Termin – der einzige Eintrag mit vollem Akzent. */
  isNext?: boolean;
  ref: Date;
}

const { entry, locale, upcoming, isNext, ref } = Astro.props;
const c = copy[locale];
const end = entry.kind === "event" ? (entry.event.endDate ?? entry.date) : entry.date;
const dot = upcoming
  ? isNext
    ? "border-2 border-primary bg-background ring-4 ring-primary/10"
    : "border-2 border-primary/35 bg-background"
  : "bg-primary/30";

const e = entry.kind === "event" ? entry.event : undefined;
const action = e && cardAction(e, locale, c, ref);
const thumb = e && (cardImage(e, ref) as ImageMetadata | undefined);
// Gewesenes mit Material zeigt es groß – die Fotos sind der Beleg, dass hier
// wirklich Leute zusammenkommen. Vorher bleibt die Karte schlank.
const big = !upcoming && Boolean(thumb);
const extraPhotos = big ? (e?.photos ?? []).filter((p) => p.src !== thumb).slice(0, 4) : [];
// Als Literale, damit Tailwind sie findet. Ein einzelnes Zusatzfoto nimmt
// die halbe Breite, mehrere teilen sich die Zeile.
const stripCols = ["", "grid-cols-2", "grid-cols-2", "grid-cols-3", "grid-cols-4"][extraPhotos.length];
const wide = "(min-width: 1024px) 860px, (min-width: 768px) calc(100vw - 12rem), 100vw";
const chip = "rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground";
const card = "rounded-xl border border-border/60 bg-card transition-shadow hover:shadow-lg";
---

<li
  id={entry.id}
  class="timeline-row grid scroll-mt-28 grid-cols-[1.5rem_minmax(0,1fr)] md:grid-cols-[6.5rem_1.5rem_minmax(0,1fr)]"
  data-date={entry.date}
  data-end={end}
  data-column={entry.column}
  data-phase={upcoming ? "upcoming" : "past"}
  data-reveal
>
  <div class="hidden pr-4 pt-1 text-right md:block">
    <p class="font-heading text-sm font-medium text-foreground">{formatEventDateShort(entry.date, locale)}</p>
    <p class="timeline-relative text-xs text-muted-foreground" data-relative={entry.date} hidden={!upcoming}>
      {upcoming ? formatRelativeToToday(entry.date, locale, ref) : ""}
    </p>
  </div>
  <div class="flex justify-center pt-2">
    <span class={`timeline-dot h-3 w-3 shrink-0 rounded-full ${dot}`} aria-hidden="true"></span>
  </div>
  <div class={`min-w-0 pb-8 pl-3 md:pl-4 ${isNext ? "next-event-glow" : ""}`}>
    {
      entry.kind === "series" && (
        <div class="rounded-xl border border-dashed border-border bg-card/50 px-5 py-4">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class={chip}>{columnLabel(entry.column, c)}</span>
            <span class="text-xs text-muted-foreground md:hidden">{formatEventDate(entry.date, locale)}</span>
          </div>
          <p class="font-heading text-base font-semibold text-foreground">
            {entry.series.labelKey === "semesterStart" ? c.events.seriesSemesterLabel : c.events.seriesLabel}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            {entry.series.startTime} – {entry.series.endTime} · {entry.series.location} – {c.events.seriesNote}
          </p>
          <div class="mt-3">
            <AddToCalendar client:visible locale={locale} event={seriesCalendarEntry(entry.series, locale, c)} subtle />
          </div>
        </div>
      )
    }

    {
      entry.kind === "milestone" && (
        <div class={`${card} overflow-hidden`}>
          {entry.milestone.image && (
            <Image src={entry.milestone.image as ImageMetadata} alt="" widths={[640, 960, 1280]} sizes={wide} class="aspect-video w-full bg-muted object-cover object-top" />
          )}
          <div class="p-5">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            {entry.milestone.badge && (
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                {pick(entry.milestone.badge, locale)}
              </span>
            )}
            {entry.milestone.partner && <PartnerChip partner={entry.milestone.partner} />}
            <span class="text-xs text-muted-foreground md:hidden">{formatEventDate(entry.date, locale)}</span>
          </div>
          <h2 class="font-heading text-lg font-semibold text-foreground">{pick(entry.milestone.title, locale)}</h2>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{pick(entry.milestone.description, locale)}</p>
          {entry.milestone.links && (
            <div class="mt-3 flex flex-wrap gap-4">
              {entry.milestone.links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  {pick(l.label, locale)}
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              ))}
            </div>
          )}
          </div>
        </div>
      )
    }

    {
      e && (
        <article class={`${card} overflow-hidden`}>
          {big && (
            <a href={action?.href} {...(action?.external ? { target: "_blank", rel: "noopener noreferrer" } : {})} tabindex="-1" aria-hidden="true" class="group relative block">
              <Image src={thumb!} alt="" widths={[640, 960, 1280]} sizes={wide} class="aspect-video w-full bg-muted object-cover" />
              {e.recording && thumb === e.recording.thumbnail && (
                <span class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20">
                  <PlayCircle size={64} strokeWidth={1.5} className="text-white drop-shadow-lg" aria-hidden="true" />
                </span>
              )}
            </a>
          )}
          {extraPhotos.length > 0 && (
            <ul class={`grid gap-1 pt-1 ${stripCols}`}>
              {extraPhotos.map((p) => (
                <li>
                  <Image src={p.src as ImageMetadata} alt={pick(p.alt, locale) ?? ""} widths={[220, 440]} sizes="(min-width: 1024px) 215px, 25vw" class="aspect-[4/3] w-full bg-muted object-cover" />
                </li>
              ))}
            </ul>
          )}
          <div class="flex gap-4 p-5">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <span class={chip}>{columnLabel(e.column, c)}</span>
                {e.partner?.tone && <PartnerChip partner={e.partner} />}
                {e.highlightBadge && (
                  <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
                    {pick(e.highlightBadge, locale)}
                  </span>
                )}
                {e.status !== "scheduled" && (
                  <span class="rounded-full bg-destructive/10 px-2.5 py-0.5 text-xs font-medium text-destructive">
                    {e.status === "cancelled" ? c.eventPage.status.cancelled : c.eventPage.status.postponed}
                  </span>
                )}
                <span class="text-xs text-muted-foreground md:hidden">{formatEventDate(e.date, locale)}</span>
              </div>
              <h2 class="font-heading text-lg font-semibold leading-snug text-foreground">
                {
                  action ? (
                    <a
                      href={action.href}
                      {...(action.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                      class="hover:text-primary"
                    >
                      {pick(e.title, locale)}
                    </a>
                  ) : (
                    pick(e.title, locale)
                  )
                }
              </h2>
              {e.subtitle && <p class="mt-0.5 text-sm text-muted-foreground">{pick(e.subtitle, locale)}</p>}
              <p class="mt-2 text-sm text-muted-foreground">
                {[e.speaker, upcoming && formatEventTime(e, locale), upcoming && pick(e.location, locale)]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
              {
                !upcoming && (e.recording || e.photos?.length) && (
                  <p class="mt-2 flex flex-wrap gap-3 text-xs text-muted-foreground">
                    {e.recording && (
                      <span class="inline-flex items-center gap-1">
                        <PlayCircle size={13} aria-hidden="true" />
                        {c.eventPage.hasRecording}
                      </span>
                    )}
                    {e.photos?.length && (
                      <span class="inline-flex items-center gap-1">
                        <ImageIcon size={13} aria-hidden="true" />
                        {c.eventPage.hasPhotos}
                      </span>
                    )}
                  </p>
                )
              }
              {
                // Dasselbe Ziel wie der Titel – sichtbar für die Maus, für
                // Tastatur und Screenreader genügt ein Link pro Karte.
                action && (
                  <a
                    href={action.href}
                    {...(action.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="mt-3 inline-flex items-center gap-1 font-heading text-sm font-medium text-primary hover:underline"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    {action.label}
                    {action.external ? <ExternalLink size={13} aria-hidden="true" /> : <ArrowRight size={14} aria-hidden="true" />}
                  </a>
                )
              }
            </div>
            {
              !big && thumb ? (
                <Image src={thumb} alt="" width={176} height={99} densities={[1, 2]} class="hidden aspect-video w-44 shrink-0 self-start rounded-lg object-cover sm:block" />
              ) : (
                !big &&
                e.speakerPhoto && (
                  <Image
                    src={e.speakerPhoto as ImageMetadata}
                    alt=""
                    width={64}
                    height={64}
                    densities={[1, 2]}
                    class="h-16 w-16 shrink-0 self-start rounded-full object-cover"
                  />
                )
              )
            }
          </div>
        </article>
      )
    }
  </div>
</li>
