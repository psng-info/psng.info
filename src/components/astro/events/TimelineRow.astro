---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ExternalLink } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { seriesCalendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDate, formatEventDateShort, formatRelativeToToday } from "@/lib/events/format";
import type { TimelineEntry } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { columnLabel } from "@/lib/events/view";
import EventCard from "./cards/EventCard.astro";
import GatheringCard from "./cards/GatheringCard.astro";
import HighlightCard from "./cards/HighlightCard.astro";
import PartnerChip from "./PartnerChip.astro";

/*
 * Eine Zeile im Zeitstrahl: Datum, Punkt auf der Schiene, Karte. Die Karten
 * zeigen alles, was es zu einem Event gibt – /events ist das Schaufenster;
 * die eigene Seite eines Events ist zum Teilen da. `data-date` und `data-end`
 * braucht scripts/timeline.ts, um Heute-Marker und Abstände nach dem
 * Build-Tag nachzuführen.
 */
interface Props {
  entry: TimelineEntry;
  /** Alle Events – für den Verweis „Teil von …“. */
  events: SiteEvent[];
  locale: Locale;
  upcoming: boolean;
  /** Der nächste anstehende Termin – der einzige Eintrag mit vollem Akzent. */
  isNext?: boolean;
  ref: Date;
}

const { entry, events, locale, upcoming, isNext, ref } = Astro.props;
const c = copy[locale];
const end = entry.kind === "event" ? (entry.event.endDate ?? entry.date) : entry.date;
const dot = upcoming
  ? isNext
    ? "border-2 border-primary bg-background ring-4 ring-primary/10"
    : "border-2 border-primary/35 bg-background"
  : "bg-primary/30";
const wide = "(min-width: 1024px) 860px, (min-width: 768px) calc(100vw - 12rem), 100vw";
const chip = "rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground";
const card = "rounded-xl border border-border/60 bg-card transition-shadow hover:shadow-lg";
---

<li
  id={entry.id}
  class="timeline-row grid scroll-mt-28 grid-cols-[1.5rem_minmax(0,1fr)] md:grid-cols-[6.5rem_1.5rem_minmax(0,1fr)]"
  data-date={entry.date}
  data-end={end}
  data-column={entry.column}
  data-phase={upcoming ? "upcoming" : "past"}
  data-reveal
>
  <div class="hidden pr-4 pt-1 text-right md:block">
    <p class="font-heading text-sm font-medium text-foreground">{formatEventDateShort(entry.date, locale)}</p>
    <p class="timeline-relative text-xs text-muted-foreground" data-relative={entry.date} hidden={!upcoming}>
      {upcoming ? formatRelativeToToday(entry.date, locale, ref) : ""}
    </p>
  </div>
  <div class="flex justify-center pt-2">
    <span class={`timeline-dot h-3 w-3 shrink-0 rounded-full ${dot}`} aria-hidden="true"></span>
  </div>
  <div class={`min-w-0 pb-8 pl-3 md:pl-4 ${isNext ? "next-event-glow" : ""}`}>
    {
      entry.kind === "series" && (
        <div class="rounded-xl border border-dashed border-border bg-card/50 px-5 py-4">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class={chip}>{columnLabel(entry.column, c)}</span>
            <span class="text-xs text-muted-foreground md:hidden">{formatEventDate(entry.date, locale)}</span>
          </div>
          <p class="font-heading text-base font-semibold text-foreground">
            {entry.series.labelKey === "semesterStart" ? c.events.seriesSemesterLabel : c.events.seriesLabel}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            {entry.series.startTime} – {entry.series.endTime} · {entry.series.location} – {c.events.seriesNote}
          </p>
          <div class="mt-3">
            <AddToCalendar client:visible locale={locale} event={seriesCalendarEntry(entry.series, locale, c)} subtle />
          </div>
        </div>
      )
    }

    {
      entry.kind === "milestone" && (
        <div class={`${card} overflow-hidden`}>
          {entry.milestone.image && (
            <Image src={entry.milestone.image as ImageMetadata} alt="" widths={[640, 960, 1280]} sizes={wide} class="aspect-video w-full bg-muted object-cover object-top" />
          )}
          <div class="p-5">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            {entry.milestone.badge && (
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                {pick(entry.milestone.badge, locale)}
              </span>
            )}
            {entry.milestone.partner && <PartnerChip partner={entry.milestone.partner} />}
            <span class="text-xs text-muted-foreground md:hidden">{formatEventDate(entry.date, locale)}</span>
          </div>
          <h2 class="font-heading text-lg font-semibold text-foreground">{pick(entry.milestone.title, locale)}</h2>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{pick(entry.milestone.description, locale)}</p>
          {entry.milestone.links && (
            <div class="mt-3 flex flex-wrap gap-4">
              {entry.milestone.links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  {pick(l.label, locale)}
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              ))}
            </div>
          )}
          </div>
        </div>
      )
    }

    {
      entry.kind === "event" &&
        (upcoming || entry.variant === "plain" ? (
          <EventCard event={entry.event} events={events} locale={locale} past={!upcoming} ref={ref} />
        ) : entry.variant === "feature" ? (
          <GatheringCard event={entry.event} locale={locale} />
        ) : (
          <HighlightCard event={entry.event} events={events} locale={locale} />
        ))
    }
  </div>
</li>
