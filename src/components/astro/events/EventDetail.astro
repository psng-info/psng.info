---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowLeft, ArrowRight, ChevronLeft, ChevronRight, ExternalLink } from "lucide-react";
import AddToCalendar from "@/components/AddToCalendarIsland";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { pathFor } from "@/i18n/routes";
import { calendarEntry, seriesCalendarEntry } from "@/lib/events/calendarEntry";
import { formatEventDate, formatEventDateRange, formatEventTime } from "@/lib/events/format";
import { eventPath } from "@/lib/events/paths";
import { canRegister, getChildEvents, getUpcomingAgenda, hasPage, isPast, isTranslated } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { columnLabel } from "@/lib/events/view";
import { getYouTubeEmbedUrl } from "@/lib/youtube";
import PartnerChip from "./PartnerChip.astro";

/*
 * Die Seite eines Events. Vorher stehen Fakten und Anmeldung vorn, nachher
 * der Rückblick – Aufzeichnung, Fotos, Zahlen. Was in den Daten fehlt, wird
 * nicht gerendert, auch keine leere Überschrift.
 */
interface Props {
  event: SiteEvent;
  events: SiteEvent[];
  locale: Locale;
  ref: Date;
}

const { event: e, events, locale, ref } = Astro.props;
const c = copy[locale];
const p = c.eventPage;
const past = isPast(e, ref);
const title = pick(e.title, locale);
const calendar = !past ? calendarEntry(e, locale, c) : undefined;
const register = canRegister(e, ref) && e.registrationUrl;
const children = getChildEvents(events, e.slug);
const parent = e.partOf ? events.find((x) => x.slug === e.partOf) : undefined;
// Die Nachbarn in der Zeit, unter allen Events mit eigener Seite.
const chronological = events.filter(hasPage).sort((a, b) => a.date.localeCompare(b.date) || a.slug.localeCompare(b.slug));
const position = chronological.findIndex((x) => x.slug === e.slug);
const neighbours = { prev: chronological[position - 1], next: chronological[position + 1] };
const next = getUpcomingAgenda(events, ref)
  .filter((x) => x.kind === "series" || (x.event.slug !== e.slug && hasPage(x.event)))
  .slice(0, 2);
const embed = e.recording && getYouTubeEmbedUrl(e.recording.url);
const shortEmbed = e.short && getYouTubeEmbedUrl(e.short.url);
const img = (i: unknown) => i as ImageMetadata;
const attendance = e.attendance === "online" ? p.online : e.attendance === "hybrid" ? p.hybrid : undefined;

const h2 = "mb-3 font-heading text-xl font-semibold text-foreground";
const photos = e.photos ?? [];
const hasNumbers = past && Boolean(e.attendees || e.rating || e.recommendPercent || e.slidesUrl || e.recapUrl);
const external = { target: "_blank", rel: "noopener noreferrer" };
const textLink = "inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline";
---

<article class="container mx-auto max-w-5xl px-6 pb-24 pt-32 md:pt-40">
  <nav class="mb-8 flex items-center justify-between gap-4" aria-label={p.allEvents}>
    {/* Zurück an dieselbe Stelle im Zeitstrahl, nicht an dessen Anfang. */}
    <a
      href={`${pathFor("events", locale)}#${e.slug}`}
      class="inline-flex items-center gap-2 font-heading text-sm text-muted-foreground transition-colors hover:text-primary"
    >
      <ArrowLeft size={16} aria-hidden="true" />
      {p.allEvents}
    </a>
    <div class="flex gap-2">
      {
        // Wie im Zeitstrahl, wo das Neuere oben steht: links geht es zum
        // späteren Event, rechts zum früheren.
        (["next", "prev"] as const).map((dir) => {
          const target = neighbours[dir];
          const Icon = dir === "next" ? ChevronLeft : ChevronRight;
          const label = dir === "prev" ? p.prevEvent : p.nextEvent;
          const cls = "flex h-9 w-9 items-center justify-center rounded-full border border-border";
          return target ? (
            <a href={eventPath(target.slug, locale)} class={`${cls} text-foreground transition-colors hover:border-primary hover:text-primary`} aria-label={`${label}: ${pick(target.title, locale)}`} title={pick(target.title, locale)}>
              <Icon size={18} aria-hidden="true" />
            </a>
          ) : (
            <span class={`${cls} text-muted-foreground/40`} aria-hidden="true">
              <Icon size={18} />
            </span>
          );
        })
      }
    </div>
  </nav>

  {locale === "en" && !isTranslated(e) && <p class="mb-6 rounded-lg bg-muted px-4 py-2 text-sm text-muted-foreground">{p.untranslated}</p>}

  <header class="mb-10">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">{columnLabel(e.column, c)}</span>
      {
        e.speakerType && (
          <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            {e.speakerType === "student" ? c.events.speakerTypes.student : c.events.speakerTypes.guest}
          </span>
        )
      }
      {e.partner?.tone && <PartnerChip partner={e.partner} />}
      {e.highlightBadge && <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">{pick(e.highlightBadge, locale)}</span>}
    </div>
    <h1 class="font-heading text-3xl font-bold leading-tight text-foreground md:text-5xl">{title}</h1>
    {e.subtitle && <p class="mt-3 text-lg text-muted-foreground">{pick(e.subtitle, locale)}</p>}
    {
      parent && (
        <p class="mt-3 text-sm text-muted-foreground">
          {c.events.partOf}{" "}
          <a href={eventPath(parent.slug, locale)} class="font-medium text-primary hover:underline">
            {pick(parent.title, locale)}
          </a>
        </p>
      )
    }
  </header>

  {
    e.status !== "scheduled" ? (
      <div class="mb-10 rounded-xl border border-destructive/30 bg-destructive/5 px-5 py-4" role="status">
        <p class="font-heading font-semibold text-destructive">
          {e.status === "cancelled" ? p.status.cancelled : p.status.postponed}
        </p>
        <p class="text-sm text-muted-foreground">{e.status === "cancelled" ? p.status.cancelledText : p.status.postponedText}</p>
      </div>
    ) : (
      e.rescheduledFrom &&
      !past && (
        <p class="mb-10 rounded-xl bg-amber-50 px-5 py-3 text-sm text-amber-900" role="status">
          {p.status.rescheduledBefore}
          {formatEventDate(e.rescheduledFrom, locale)}.
        </p>
      )
    )
  }

  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_17rem]">
    <div class="min-w-0 space-y-10">
      {
        past && embed && (
          <section>
            <h2 class="sr-only">{p.recording}</h2>
            <div class="relative aspect-video overflow-hidden rounded-xl bg-muted">
              <button
                type="button"
                data-youtube={embed}
                data-title={title}
                class="group absolute inset-0 flex items-center justify-center"
                aria-label={`${c.events.playRecording} ${title}`}
              >
                <Image src={img(e.recording!.thumbnail)} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 640px, 100vw" class="absolute inset-0 h-full w-full object-cover" />
                <span class="absolute inset-0 bg-black/25 transition-colors group-hover:bg-black/40"></span>
                <span class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-foreground shadow-lg transition-transform group-hover:scale-110">
                  <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                </span>
              </button>
            </div>
          </section>
        )
      }

      {
        past && photos.length > 0 && (
          <section>
            <h2 class={h2}>{p.photos}</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {photos.slice(0, 3).map((photo, i) => (
                <a href={img(photo.src).src} class={`block overflow-hidden rounded-lg bg-muted ${i === 0 ? "col-span-2 row-span-2" : ""}`}>
                  <Image
                    src={img(photo.src)}
                    alt={pick(photo.alt, locale) ?? ""}
                    widths={i === 0 ? [640, 1024] : [320, 640]}
                    sizes={i === 0 ? "(min-width: 768px) 440px, 100vw" : "(min-width: 768px) 220px, 50vw"}
                    class="aspect-[4/3] h-full w-full object-cover transition-transform hover:scale-[1.02]"
                  />
                </a>
              ))}
            </div>
            {photos.length > 3 && (
              <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {photos.slice(3).map((photo) => (
                  <a href={img(photo.src).src} class="block overflow-hidden rounded-lg bg-muted">
                    <Image
                      src={img(photo.src)}
                      alt={pick(photo.alt, locale) ?? ""}
                      widths={[240, 480]}
                      sizes="(min-width: 768px) 165px, 50vw"
                      class="aspect-[4/3] h-full w-full object-cover transition-transform hover:scale-[1.02]"
                    />
                  </a>
                ))}
              </div>
            )}
          </section>
        )
      }

      {
        (e.description || e.abstract) && (
          <section>
            <h2 class={h2}>{e.abstract ? p.abstract : p.about}</h2>
            {e.language && e.language !== locale && (
              <p class="mb-3 text-sm text-muted-foreground">
                {(e.category === "lecture" ? c.events.languageNote.talk : c.events.languageNote.event).before}
                <span class="font-medium text-foreground">
                  {(e.category === "lecture" ? c.events.languageNote.talk : c.events.languageNote.event).in}
                  {c.events.languages[e.language]}
                </span>.
              </p>
            )}
            {e.abstract ? (
              <>
                {e.abstract.title && <h3 class="mb-2 font-heading font-semibold text-foreground">{pick(e.abstract.title, locale)}</h3>}
                <p class="whitespace-pre-line leading-relaxed text-muted-foreground">{pick(e.abstract.text, locale)}</p>
              </>
            ) : (
              <p class="whitespace-pre-line leading-relaxed text-muted-foreground">{pick(e.description, locale)}</p>
            )}
            {e.audienceNote && <p class="mt-3 text-sm text-muted-foreground">{pick(e.audienceNote, locale)}</p>}
            {e.contribution && (
              <p class="mt-3 text-sm text-muted-foreground">
                <span class="font-medium text-foreground">{c.events.contributionLabel}</span> {pick(e.contribution, locale)}
              </p>
            )}
          </section>
        )
      }

      {
        children.length > 0 && (
          <section>
            <h2 class={h2}>{p.talksThatEvening}</h2>
            <ul class="space-y-3">
              {children.map((child) => (
                <li class="rounded-xl border border-border/60 bg-card p-4">
                  <a href={eventPath(child.slug, locale)} class="font-heading font-semibold text-foreground hover:text-primary">
                    {pick(child.title, locale)}
                  </a>
                  {child.speaker && <p class="text-sm text-muted-foreground">{child.speaker}</p>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        e.speaker && (e.speakerBio || e.speakerPhoto) && (
          <section>
            <h2 class={h2}>{p.speaker}</h2>
            <div class="flex gap-4">
              {e.speakerPhoto && (
                <Image src={img(e.speakerPhoto)} alt={e.speaker} width={96} height={96} densities={[1, 2]} class="h-24 w-24 shrink-0 rounded-full object-cover" />
              )}
              <div>
                <p class="font-heading font-semibold text-foreground">{e.speaker}</p>
                {e.speakerBio && <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{pick(e.speakerBio, locale)}</p>}
                {(e.speakerWebsiteUrl || e.speakerLinkedinUrl) && (
                  <div class="mt-2 flex flex-wrap gap-4">
                    {e.speakerWebsiteUrl && <a href={e.speakerWebsiteUrl} {...external} class={textLink}>{c.events.learnMore}<ExternalLink size={13} aria-hidden="true" /></a>}
                    {e.speakerLinkedinUrl && <a href={e.speakerLinkedinUrl} {...external} class={textLink}>{c.events.linkedin}<ExternalLink size={13} aria-hidden="true" /></a>}
                  </div>
                )}
              </div>
            </div>
          </section>
        )
      }

      {
        e.partner && (
          <section>
            <h2 class={h2}>{p.partner}</h2>
            <div class="flex items-center gap-4">
              <Image src={img(e.partner.logo)} alt={`${e.partner.name} Logo`} height={56} densities={[1, 2]} class="h-14 w-auto" />
              <div>
                <a href={e.partner.url} {...external} class="font-heading font-semibold text-foreground hover:text-primary">{e.partner.name}</a>
                {e.partner.role && <p class="text-sm text-muted-foreground">{pick(e.partner.role, locale)}</p>}
              </div>
            </div>
          </section>
        )
      }

      {
        e.furtherReading?.length && (
          <section>
            <h2 class={h2}>{c.events.furtherReading}</h2>
            <ul class="space-y-2">
              {e.furtherReading.map((r) => (
                <li>
                  <a href={r.url} {...external} class="text-sm text-primary hover:underline">{pick(r.text, locale)}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {e.disclaimer && <p class="text-sm italic text-muted-foreground">{pick(e.disclaimer, locale)}</p>}
    </div>

    <div class:list={["space-y-4 md:self-start", !past && "md:sticky md:top-24"]}>
      <div class="space-y-4 rounded-xl border border-border/60 bg-card p-5">
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.when}</dt>
            <dd class="font-medium text-foreground">{formatEventDateRange(e, locale)}</dd>
            <dd class="text-muted-foreground">{formatEventTime(e, locale)}</dd>
          </div>
          {
            (e.location || attendance) && (
              <div>
                <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.where}</dt>
                {e.location && <dd class="font-medium text-foreground">{pick(e.location, locale)}</dd>}
                {e.venue?.street && !pick(e.location, locale)?.includes(e.venue.street) && (
                  <dd class="text-muted-foreground">
                    {e.venue.street}, {e.venue.postalCode} {e.venue.city}
                  </dd>
                )}
              </div>
            )
          }
          {
            e.language && (
              <div>
                <dt class="text-xs uppercase tracking-wider text-muted-foreground">{p.language}</dt>
                <dd class="font-medium text-foreground">{c.events.languages[e.language]}</dd>
              </div>
            )
          }
        </dl>
        {
          register ? (
            <a
              href={e.registrationUrl}
              {...external}
              class="gradient-psychedelic flex w-full items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 font-heading text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
            >
              {pick(e.registrationLabel, locale) ?? c.events.register}
              <ExternalLink size={14} aria-hidden="true" />
            </a>
          ) : (
            !past &&
            e.status === "scheduled" &&
            e.registrationState !== "open" && (
              <p class="rounded-lg bg-muted px-4 py-2.5 text-center text-sm font-medium text-muted-foreground">
                {e.registrationState === "full" ? p.registration.full : p.registration.closed}
              </p>
            )
          )
        }
        {
          // Eigener Block: Die Insel selbst ist `display: contents` und nimmt
          // den Abstand von `space-y-4` nicht an.
          calendar && (
            <div>
              <AddToCalendar client:visible locale={locale} event={calendar} />
            </div>
          )
        }
        {
          (e.websiteUrl || e.externalUrl) && (
            <a href={e.websiteUrl ?? e.externalUrl} {...external} class={textLink}>
              {pick(e.websiteLabel ?? e.externalLabel, locale) ?? p.toWebsite}
              <ExternalLink size={13} aria-hidden="true" />
            </a>
          )
        }
      </div>
      {
        hasNumbers && (
          <section class="rounded-xl border border-border/60 bg-card p-5">
            <h2 class="sr-only">{p.numbers}</h2>
            <dl class="grid grid-cols-2 gap-x-4 gap-y-3">
              {e.attendees && (
                <div>
                  <dt class="text-xs text-muted-foreground">{c.events.attendees}</dt>
                  <dd class="font-heading text-2xl font-bold text-foreground">{e.attendees}</dd>
                </div>
              )}
              {e.attendeesOnline !== undefined && (
                <div>
                  <dt class="text-xs text-muted-foreground">{p.ofWhichOnline}</dt>
                  <dd class="font-heading text-2xl font-bold text-foreground">{e.attendeesOnline}</dd>
                </div>
              )}
              {e.rating && (
                <div>
                  <dt class="text-xs text-muted-foreground">{c.events.rating}</dt>
                  <dd class="font-heading text-2xl font-bold text-foreground">{e.rating}</dd>
                </div>
              )}
              {e.recommendPercent !== undefined && (
                <div>
                  <dt class="text-xs text-muted-foreground">{c.events.recommend}</dt>
                  <dd class="font-heading text-2xl font-bold text-foreground">{e.recommendPercent} %</dd>
                </div>
              )}
            </dl>
            {(e.slidesUrl || e.recapUrl) && (
              <div class="mt-4 flex flex-wrap gap-4 border-t border-border/50 pt-4">
                {e.slidesUrl && <a href={e.slidesUrl} {...external} class={textLink}>{c.events.slides}</a>}
                {e.recapUrl && <a href={e.recapUrl} {...external} class={textLink}>{c.events.recap}</a>}
              </div>
            )}
          </section>
        )
      }
      {
        past && shortEmbed && (
          <div class="relative mx-auto aspect-[9/16] w-full max-w-[17rem] overflow-hidden rounded-xl bg-muted">
            <button
              type="button"
              data-youtube={shortEmbed}
              data-title={c.events.shortTitle}
              class="group absolute inset-0 flex items-center justify-center"
              aria-label={`${c.events.playShort} ${title}`}
            >
              <Image src={img(e.short!.thumbnail)} alt="" width={272} height={484} densities={[1, 2]} class="absolute inset-0 h-full w-full object-cover" />
              <span class="absolute inset-0 bg-black/25 transition-colors group-hover:bg-black/40"></span>
              <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-foreground shadow-lg transition-transform group-hover:scale-110">
                <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </button>
          </div>
        )
      }
    </div>
  </div>

  {
    (neighbours.prev || neighbours.next) && (
      <nav class="mt-16 grid gap-4 border-t border-border/60 pt-10 sm:grid-cols-2" aria-label={`${p.nextEvent} / ${p.prevEvent}`}>
        {neighbours.next ? (
          <a href={eventPath(neighbours.next.slug, locale)} class="group rounded-xl border border-border/60 bg-card p-5 transition-shadow hover:shadow-lg">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              <ChevronLeft size={14} aria-hidden="true" />
              {p.nextEvent} · {formatEventDate(neighbours.next.date, locale)}
            </span>
            <span class="mt-1 block font-heading font-semibold text-foreground group-hover:text-primary">{pick(neighbours.next.title, locale)}</span>
          </a>
        ) : (
          <span />
        )}
        {neighbours.prev && (
          <a href={eventPath(neighbours.prev.slug, locale)} class="group rounded-xl border border-border/60 bg-card p-5 text-right transition-shadow hover:shadow-lg">
            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
              {p.prevEvent} · {formatEventDate(neighbours.prev.date, locale)}
              <ChevronRight size={14} aria-hidden="true" />
            </span>
            <span class="mt-1 block font-heading font-semibold text-foreground group-hover:text-primary">{pick(neighbours.prev.title, locale)}</span>
          </a>
        )}
      </nav>
    )
  }

  {
    next.length > 0 && (
      <section class="mt-16 border-t border-border/60 pt-10">
        <h2 class={h2}>{p.next}</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {next.map((entry) => (
            <li class="rounded-xl border border-border/60 bg-card p-5">
              <p class="text-xs text-muted-foreground">{formatEventDate(entry.date, locale, true)}</p>
              {entry.kind === "event" ? (
                <a href={eventPath(entry.event.slug, locale)} class="mt-1 inline-flex items-center gap-1 font-heading font-semibold text-foreground hover:text-primary">
                  {pick(entry.event.title, locale)}
                  <ArrowRight size={14} aria-hidden="true" />
                </a>
              ) : (
                <>
                  <p class="mt-1 font-heading font-semibold text-foreground">
                    {entry.series.labelKey === "semesterStart" ? c.events.seriesSemesterLabel : c.events.seriesLabel}
                  </p>
                  <div class="mt-2">
                    <AddToCalendar client:visible locale={locale} event={seriesCalendarEntry(entry.series, locale, c)} subtle />
                  </div>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

<script>
  import { initYouTubeButtons } from "@/scripts/youtube";
  initYouTubeButtons();
</script>
