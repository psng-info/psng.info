---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ChevronLeft, ChevronRight } from "lucide-react";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import type { SiteEvent } from "@/lib/events/types";

/*
 * Die Fotos eines Events zum Durchblättern (scripts/carousel.ts).
 *
 * - `hero`: randlos oben auf der Karte, 16:9 – die Quellen sind so zugeschnitten.
 * - `side`: in der Spalte neben dem Text, 3:2 mit Beschnitt und Zähler.
 *   Kamerafotos sind ohnehin 3:2, bei Video-Stills fällt am Rand wenig weg.
 * - `contain`: unbeschnitten in fester Höhe, für Fotos in gemischten Formaten –
 *   ein hartes Zuschneiden hätte dort Köpfe abgeschnitten.
 */
interface Props {
  photos: NonNullable<SiteEvent["photos"]>;
  title: string;
  locale: Locale;
  variant: "hero" | "side" | "contain";
}

const { photos, title, locale, variant } = Astro.props;
const c = copy[locale];
const frame = {
  hero: "aspect-video w-full bg-muted",
  side: "aspect-[3/2] w-full overflow-hidden rounded-lg bg-muted",
  contain: "flex h-72 w-full items-center justify-center overflow-hidden rounded-lg bg-muted sm:h-96 md:h-[28rem]",
}[variant];
const fit = variant === "contain" ? "h-full w-full object-contain" : "h-full w-full object-cover";
const sizes = variant === "side" ? "(min-width: 768px) 420px, 100vw" : "(min-width: 1024px) 860px, 100vw";
const arrow =
  "absolute top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/90 text-foreground shadow-sm transition-colors hover:bg-background";
---

<div class:list={["space-y-2", variant === "side" && "md:self-start"]}>
  <div class="relative" data-carousel>
    <ul
      data-carousel-track
      tabindex="0"
      aria-label={`${c.eventPage.photos}: ${title}`}
      class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary [&::-webkit-scrollbar]:hidden"
    >
      {
        photos.map((photo, i) => (
          <li class="w-full shrink-0 snap-center">
            <div class={frame}>
              <Image
                src={photo.src as ImageMetadata}
                alt={pick(photo.alt, locale) ?? `${title} – ${c.events.photoFallback} ${i + 1}`}
                widths={[480, 960, 1440]}
                sizes={sizes}
                class={fit}
              />
            </div>
          </li>
        ))
      }
    </ul>
    {
      photos.length > 1 && (
        <>
          <button type="button" data-carousel-prev class={`${arrow} left-2`} aria-label={c.events.prevPhoto}>
            <ChevronLeft size={18} aria-hidden="true" />
          </button>
          <button type="button" data-carousel-next class={`${arrow} right-2`} aria-label={c.events.nextPhoto}>
            <ChevronRight size={18} aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>
  {
    variant === "side" && photos.length > 1 && (
      <p data-carousel-count class="text-center text-xs tabular-nums text-muted-foreground" aria-live="polite">
        1 / {photos.length}
      </p>
    )
  }
</div>
