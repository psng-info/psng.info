---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowRight } from "lucide-react";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { formatEventDate } from "@/lib/events/format";
import { eventPath } from "@/lib/events/paths";
import { hasPage } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { columnLabel } from "@/lib/events/view";
import { getYouTubeEmbedUrl } from "@/lib/youtube";
import PartnerChip from "../PartnerChip.astro";
import LanguageNote from "./LanguageNote.astro";
import PartnerStrip from "./PartnerStrip.astro";
import PhotoCarousel from "./PhotoCarousel.astro";
import YouTubeButton from "./YouTubeButton.astro";

/*
 * Ein vergangenes Event mit Material, wie es auf der alten Startseite stand:
 * oben die Aufzeichnung oder die Fotos in voller Breite, darunter der ganze
 * Text. Mit Video oben bekommen die Fotos eine eigene Spalte neben dem Text,
 * statt dass sie ungesehen hinter dem Video verschwinden.
 */
interface Props {
  event: SiteEvent;
  events: SiteEvent[];
  locale: Locale;
}

const { event: e, events, locale } = Astro.props;
const c = copy[locale];
const title = pick(e.title, locale);
const embed = e.recording && getYouTubeEmbedUrl(e.recording.url);
const photos = e.photos ?? [];
const sidePhotos = embed && photos.length ? photos : undefined;
const parent = e.partOf ? events.find((x) => x.slug === e.partOf) : undefined;
const luma = Boolean(e.registrationUrl?.includes("luma.com"));
const external = { target: "_blank", rel: "noopener noreferrer" };
const link = "font-medium text-primary hover:underline";
---

<article class="overflow-hidden rounded-xl border border-border/60 bg-card transition-shadow hover:shadow-lg">
  {
    embed ? (
      <div class="relative aspect-video w-full bg-muted">
        <YouTubeButton embed={embed} thumbnail={e.recording!.thumbnail} title={title} label={`${c.events.playRecording} ${title}`} />
      </div>
    ) : photos.length > 1 ? (
      <PhotoCarousel photos={photos} title={title} locale={locale} variant="hero" />
    ) : photos.length === 1 ? (
      <div class="aspect-video w-full bg-muted">
        <Image
          src={photos[0].src as ImageMetadata}
          alt={pick(photos[0].alt, locale) ?? title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 860px, 100vw"
          class="h-full w-full object-cover"
        />
      </div>
    ) : null
  }

  <div class:list={[sidePhotos ? "grid gap-5 p-5 md:grid-cols-2 md:gap-6" : "p-5"]}>
    <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">{columnLabel(e.column, c)}</span>
        {
          e.speakerType && (
            <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
              {e.speakerType === "student" ? c.events.speakerTypes.student : c.events.speakerTypes.guest}
            </span>
          )
        }
        {e.partner?.tone && <PartnerChip partner={e.partner} />}
        {e.featured && <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">{c.events.firstEvent}</span>}
        <span>{formatEventDate(e.date, locale)}</span>
      </div>

      <div class="space-y-2">
        <h2 class="font-heading text-lg font-semibold leading-snug text-foreground">{title}</h2>
        {e.subtitle && <p class="text-sm font-medium leading-relaxed text-foreground/80">{pick(e.subtitle, locale)}</p>}
        {e.speaker && <p class="text-sm text-muted-foreground">{c.events.with} {e.speaker}</p>}
        {e.location && <p class="text-sm text-muted-foreground">{pick(e.location, locale)}</p>}
        {
          parent && (
            <p class="text-sm text-muted-foreground">
              {c.events.partOf}{" "}
              <a href={`#${parent.slug}`} class={link}>
                {pick(parent.title, locale)}
              </a>
            </p>
          )
        }
        <LanguageNote event={e} locale={locale} />
      </div>
      {e.description && <p class="whitespace-pre-line text-sm text-muted-foreground">{pick(e.description, locale)}</p>}
      {
        // Die Kurzvita gehört auch in den Rückblick: Wer den Vortrag Monate
        // später findet, kennt den Namen darüber in der Regel nicht.
        e.speakerBio && <p class="text-sm text-muted-foreground">{pick(e.speakerBio, locale)}</p>
      }
      {
        e.furtherReading?.length && (
          <div>
            <p class="font-heading text-xs font-medium text-foreground">{c.events.furtherReading}</p>
            <ul class="mt-1.5 space-y-1.5">
              {e.furtherReading.map((r) => (
                <li class="text-xs leading-relaxed">
                  <a href={r.url} {...external} class="text-muted-foreground underline decoration-border underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">
                    {pick(r.text, locale)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-sm">
        {
          e.attendees && (
            <span class="text-muted-foreground">
              {e.attendeesOnline !== undefined
                ? `${e.attendees} ${c.events.attendees} – ${e.attendeesOnline} ${c.events.online}, ${e.attendees - e.attendeesOnline} ${c.events.inPerson}`
                : `${e.attendees}+ ${c.events.attendeesPlus}`}
            </span>
          )
        }
        {e.slidesUrl && <a href={e.slidesUrl} {...external} class={link}>{c.events.slides}</a>}
        {e.recapUrl && <a href={e.recapUrl} {...external} class={link}>{c.events.recap}</a>}
        {
          e.speakerLinkedinUrl && (
            <a href={e.speakerLinkedinUrl} {...external} class={link}>
              {e.speaker ? `${c.events.linkedinOf} ${e.speaker}` : c.events.linkedin} →
            </a>
          )
        }
        {
          e.externalUrl && (
            <a href={e.externalUrl} {...external} class={link}>
              {pick(e.externalLabel, locale) ?? c.events.learnMore} →
            </a>
          )
        }
        {luma && <a href={e.registrationUrl} {...external} class={link}>{c.events.lumaLink}</a>}
        {
          hasPage(e) && (
            <a href={eventPath(e.slug, locale)} class="inline-flex items-center gap-1 font-medium text-muted-foreground hover:text-primary">
              {c.eventPage.eventPage}
              <ArrowRight size={14} aria-hidden="true" />
            </a>
          )
        }
      </div>

      {e.disclaimer && <p class="text-xs italic text-muted-foreground">{pick(e.disclaimer, locale)}</p>}
    </div>
    {sidePhotos && <PhotoCarousel photos={sidePhotos} title={title} locale={locale} variant="side" />}
  </div>

  {e.partner && e.role === "co-hosted" && <PartnerStrip partner={e.partner} locale={locale} />}
</article>
