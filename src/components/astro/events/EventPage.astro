---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy } from "@/i18n/copy";
import type { Locale } from "@/i18n/locale";
import { pick } from "@/i18n/localized";
import { eventPath } from "@/lib/events/paths";
import { isPast, isTranslated } from "@/lib/events/schedule";
import type { SiteEvent } from "@/lib/events/types";
import { socialImageOf } from "@/lib/events/view";
import { eventNode, graph, organizationNode } from "@/lib/seo/structuredData";
import EventDetail from "./EventDetail.astro";

/*
 * Head und Gerüst einer Event-Seite. Die englische Fassung gibt es immer –
 * die Navigation soll nicht ins Leere führen –, aber Canonical und hreflang
 * nur, wenn sie wirklich übersetzt ist.
 */
interface Props {
  event: SiteEvent;
  events: SiteEvent[];
  locale: Locale;
}

const { event: e, events, locale } = Astro.props;
const c = copy[locale];
const ref = new Date();
const translated = isTranslated(e);
const alternates = translated ? { de: eventPath(e.slug, "de"), en: eventPath(e.slug, "en") } : { de: eventPath(e.slug, "de") };

// Vorschaubild in 1200 × 630, wie es LinkedIn, WhatsApp und Co. erwarten.
const social = socialImageOf(e, locale);
const og = social && (await getImage({ src: social.src as ImageMetadata, width: 1200, height: 630, fit: "cover", format: "jpg" }));
const pageImages = [og?.src, e.speakerPhoto && (await getImage({ src: e.speakerPhoto as ImageMetadata, width: 800 })).src].filter(
  (x): x is string => !!x,
);

const description =
  pick(e.description, locale)?.slice(0, 200) ??
  [pick(e.subtitle, locale), e.speaker].filter(Boolean).join(" – ") ??
  c.meta.events.description;
---

<BaseLayout
  locale={locale}
  title={`${pick(e.title, locale)} – PSNG`}
  description={description || c.meta.events.description}
  alternates={alternates}
  canonical={translated ? undefined : eventPath(e.slug, "de")}
  switchTo={{ de: eventPath(e.slug, "de"), en: eventPath(e.slug, "en") }}
  image={og && social ? { src: og.src, alt: social.alt, width: 1200, height: 630 } : undefined}
  ogType={isPast(e, ref) ? "article" : "website"}
  jsonLd={graph(organizationNode(c.meta.home.description), eventNode(e, locale, pageImages))}
  current="events"
>
  <EventDetail event={e} events={events} locale={locale} ref={ref} />
</BaseLayout>
